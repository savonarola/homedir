{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    // "openai": {
    //   "options": {
    //     "baseURL": "http://box2:2455/v1",
    //     "apiKey": "{env:CODEX_LB_API_KEY}"
    //   },
    //   "models": {
    //     "gpt-5.6-sol": {
    //       "name": "GPT-5.6-Sol",
    //       "reasoning": true,
    //       "options": { "reasoningEffort": "medium", "reasoningSummary": "detailed" },
    //       "limit": { "context": 372000, "input": 372000, "output": 65536 }
    //     }
    //   }
    // }
  },
  "mcp": {
    "tavily-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "tavily-mcp@latest"
      ],
      "enabled": true
    },
    "ziva-godot": {
      "type": "local",
      "command": [
        "/Users/av/Library/Application Support/ziva-local/bin/zivacode",
        "--mcp-bridge",
        "--godot-bin",
        "/Applications/Godot.app/Contents/MacOS/Godot",
        "--upstream",
        "http://localhost:7012/api/mcp"
      ],
      "enabled": false
    }
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/**": "allow",
      "/home/av/emq": "allow",
      "/home/av/emq/**": "allow",
      "/home/av/dev": "allow",
      "/home/av/dev/**": "allow",
      "/home/av/.local/share/opencode/repos": "allow",
      "/home/av/.local/share/opencode/**": "allow",
      "/Users/av/emq": "allow",
      "/Users/av/emq/**": "allow",
      "/Users/av/dev": "allow",
      "/Users/av/dev/**": "allow",
      "/Users/av/.local/share/opencode/repos": "allow",
      "/Users/av/.local/share/opencode/**": "allow"
    }
  }
  // "plugin": ["opencode-goal-plugin"],
  // "command": {
  //   "goal": {
  //     "description": "Set a session-scoped goal and auto-continue until complete.",
  //     "template": "$ARGUMENTS",
  //     "agent": "build"
  //   }
  // }
}

